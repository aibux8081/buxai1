rules_version = '2';
service cloudfirestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for ChatSession
    function isValidChatSession(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().size() == 4
        && data.userId is string
        && data.userId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation helper for ChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'content', 'createdAt'])
        && data.keys().size() == 4
        && data.userId is string
        && data.userId == request.auth.uid
        && data.role is string
        && (data.role == 'user' || data.role == 'model')
        && data.content is string
        && data.content.size() >= 0
        && data.content.size() <= 100000
        && data.createdAt is timestamp;
    }

    // Collection: ChatSessions
    match /chatSessions/{chatSessionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(chatSessionId) 
        && isValidChatSession(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(chatSessionId)
        && isValidChatSession(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      // Sub-collection: Messages within a session
      match /messages/{messageId} {
        allow get: if isSignedIn() 
          && get(/databases/$(database)/documents/chatSessions/$(chatSessionId)).data.userId == request.auth.uid;
        
        allow list: if isSignedIn() 
          && get(/databases/$(database)/documents/chatSessions/$(chatSessionId)).data.userId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(chatSessionId)
          && isValidId(messageId)
          && get(/databases/$(database)/documents/chatSessions/$(chatSessionId)).data.userId == request.auth.uid
          && isValidChatMessage(incoming())
          && incoming().createdAt == request.time;

        // Messages are immutable once written; allow no updates.
        allow update: if false;

        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/chatSessions/$(chatSessionId)).data.userId == request.auth.uid;
      }
    }
  }
}
